# --- Dependencies ---
node_modules/

# --- Build output ---
# Top-level `dist/` only appears if Vite is ever run without its configured
# outDir (see vite.config.ts) -- defensive, shouldn't normally exist. Anchored
# to the root (leading slash) so it doesn't also shadow backend/web/dist/.
/dist/
# The real frontend build embedded into the Go binary. Only the placeholder
# index.html is tracked, so a fresh clone's `go build` still works without
# Node -- everything else here is regenerated by `npm run build`
# (scripts/build.sh does this for you).
backend/web/dist/*
!backend/web/dist/index.html
# The final compiled binary (scripts/build.sh -> bin/davy-jones).
bin/

# --- Generated by `tsc -b` (composite project references) ---
*.tsbuildinfo
vite.config.js
vite.config.d.ts

# --- Local runtime data / secrets ---
.env
.env.local
backend/.env
data/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# --- Logs ---
*.log
npm-debug.log*
