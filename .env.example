# Frontend build-time config (Vite only reads these at dev-server start or
# build time -- copy to .env.local to override).

# Where the Vite dev server proxies /api/* to. Only matters for `npm run
# dev`; production serves everything from the single Go binary so this is
# unused there.
# VITE_API_PROXY_TARGET=http://127.0.0.1:8080

# How often (ms) the dashboard re-checks host reachability via TCP ping.
# VITE_PING_INTERVAL_MS=5000

# Backend runtime config (bind host/port, data dir, timeouts, session TTL,
# docker binary, ssh port) lives in backend/.env.example -- those are read
# by the Go server process, not the frontend.
