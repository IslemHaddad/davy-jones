# Copy to .env (or export these before launching the binary) to override
# production defaults. None are required -- every value has a sane default
# for a quick local run.

# Bind address/port for the HTTP server (serves both the API and the
# embedded frontend). Defaults to all interfaces -- narrow this to
# 127.0.0.1 and put a reverse proxy in front for any real deployment
# (see deploy/env.example, which does exactly that).
# DJ_HOST=0.0.0.0
# DJ_PORT=8080

# Where vpns.json / hosts.json / services.json / credentials.json /
# admin.json (all encrypted-at-rest, see seal/unseal below) and seal.json
# (not encrypted -- it holds no secret material) are stored. Defaults to
# the XDG data dir: $XDG_DATA_HOME/davy-jones (or
# ~/.local/share/davy-jones if XDG_DATA_HOME is unset).
# DJ_DATA_DIR=/var/lib/davy-jones

# How long an unlocked session stays valid without activity.
# DJ_SESSION_TTL_SECONDS=14400

# Port used both for SSH command execution and the TCP "is it online" ping.
# DJ_SSH_PORT=22
# DJ_SSH_DIAL_TIMEOUT_SECONDS=8
# DJ_TCP_PING_TIMEOUT_SECONDS=2

# Docker binary used for VPN client container management. Override if
# docker isn't on PATH, or you're using podman's docker-compatible CLI.
# DJ_DOCKER_BIN=docker
# DJ_DOCKER_TIMEOUT_SECONDS=15

# Shamir secret-sharing parameters for the encryption-at-rest master key.
# Only read once, the very first time /api/seal/initialize is called --
# changing these afterward has no effect on an already-initialized install.
# DJ_UNSEAL_SHARES=5
# DJ_UNSEAL_THRESHOLD=3
